# Source packages cloned into ${ROS_WS}/src by binder/Dockerfile (wstool merge + update).
# Everything else comes from apt or from the base image. The versions are pinned commits:
# change them on purpose, then check the Binder build.
#
# fanuc: FANUC support packages (incl. fanuc_cr35ia_support) and MoveIt configs.
#        launch/Fanuc_Test.launch needs fanuc_lrmate200ib_moveit_config, which is not released in apt.
- git:
    local-name: fanuc
    uri: https://github.com/ros-industrial/fanuc.git
    version: d8f42bd73584b255df87098395512538882caea1
# onrobot: OnRobot RG2/RG6/VG gripper descriptions
- git:
    local-name: onrobot
    uri: https://github.com/UOsaka-Harada-Laboratory/onrobot.git
    version: 46fae3557dd3aff678adf6b3320ec1338493d84a
