<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="MyFingerGrip" params="parent">

     <!-- GRIPPER BASE          -->
 
    <link name="gripper_base_link">
      <visual>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>

        <material name="gripperbase">
          <color rgba="1 0 1 1"/>
        </material>
      </visual>

      <!-- COLLISION -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="tool0_to_gripper" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint> 

    <!-- LEFT FINGER           -->
 
    <link name="finger_left_link">
      <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.1"/>
        </geometry>

        <material name="leftFingerGreen">
          <color rgba="0 1 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="finger_left_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="finger_left_link"/>
      <origin xyz="0 0.05 0.1" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.04" effort="10" velocity="0.1"/>
    </joint> 

    <!-- RIGHT FINGER          -->

    <link name="finger_right_link">
      <visual>
       <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.1"/>
        </geometry>

        <material name="rightFingerBlue">
          <color rgba="0 0 1 0.5"/>
        </material>
      </visual>
    </link>

    <joint name="finger_right_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="finger_right_link"/>
      <origin xyz="0 -0.05 0.1" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.04" effort="10" velocity="0.1"/>
    </joint>

  </xacro:macro>

</robot>
