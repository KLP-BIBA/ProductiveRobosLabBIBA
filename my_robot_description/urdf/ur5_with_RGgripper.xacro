<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_with_RGgripper">

  <!-- ===================== -->
  <!-- UR5 BASE ROBOT        -->
  <!-- ===================== -->

  <xacro:include filename="$(find ur_description)/urdf/inc/ur5_macro.xacro"/>

  <xacro:ur5_robot prefix="" />


  <!-- ===================== -->
  <!-- GRIPPER ADDITION      -->
  <!-- ===================== -->
 <xacro:include filename="$(find onrobot_rg_description)/urdf/onrobot_rg2.xacro" />
  <xacro:onrobot_rg2 prefix=""/>

  <!-- Attach gripper to tool0  this is default name of rosindustrial UR connection link --> 

<joint name="tool0_to_rg2" type="fixed">
  <parent link="tool0"/>
  <child link="world"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>
 

</robot>
